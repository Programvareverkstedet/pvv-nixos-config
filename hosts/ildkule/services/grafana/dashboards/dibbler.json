    {
      "id": 1,
      "type": "stat",
      "title": "Antislabbedasker",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% Antislabbedasker"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "dibbler_user_count - dibbler_debtor_count",
          "legendFormat": "Antislabbedasker",
          "refId": "A"
        },
        {
          "expr": "dibbler_user_count",
          "legendFormat": "Total users",
          "refId": "B"
        },
        {
          "expr": "100 * (dibbler_user_count - dibbler_debtor_count) / (dibbler_user_count)",
          "legendFormat": "% Antislabbedasker",
          "refId": "C"
        }
      ]
    },
