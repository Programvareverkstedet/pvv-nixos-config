{
  "id": null,
  "uid": "matrix-ooye",
  "title": "Matrix OOYE",
  "description": "Discord <-> Matrix bridge stats",
  "tags": [ "matrix" ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "style": "dark",
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Guilds",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "ooye_guilds_total",
          "legendFormat": "Guilds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Channels",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": 0 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "ooye_channels_total",
          "legendFormat": "Channels",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Matrix Users",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "ooye_users_total{type=\"matrix\"}",
          "legendFormat": "Matrix users",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Discord Users",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": 0 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "ooye_users_total{type=\"discord\"}",
          "legendFormat": "Discord users",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Connectivity",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "ooye_discord_connected",
          "legendFormat": "Discord",
          "refId": "A"
        },
        {
          "expr": "ooye_homeserver_online",
          "legendFormat": "Matrix",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages Total",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "ooye_messages_total",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Message Rate",
      "description": "Bridged messages",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:msg/h",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "clamp_min(deriv(ooye_messages_total[1h]) * 3600, 0)",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Homeserver Queue Length",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "ooye_homeserver_queue_length",
          "legendFormat": "Queued events",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Guilds",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "guild_id" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "Channels" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "Last Active" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" },
              { "id": "custom.width", "value": 200 }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Last Active" }]
      },
      "targets": [
        {
          "expr": "sum by (guild_id, guild_name) (ooye_bridged_guild_channels)",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (guild_id, guild_name) (ooye_bridged_guild_last_active_seconds) * 1000",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "guild_id", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time 1": true, "Time 2": true, "guild_name 2": true },
            "renameByName": {
              "Value #A": "Channels",
              "Value #B": "Last Active",
              "guild_name 1": "guild_name"
            },
            "indexByName": { "guild_id": 0, "guild_name 1": 1, "Value #A": 2, "Value #B": 3 }
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "heatmap",
      "title": "Guild Message Traffic",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 11
      },
      "options": {
        "calculate": false,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 16
        },
        "yAxis": {
          "axisPlacement": "left"
        },
        "cellGap": 1,
        "tooltip": { "show": true, "yHistogram": false },
        "legend": { "show": false }
      },
      "targets": [
        {
          "expr": "sum by (guild_name) (increase(ooye_bridge_messages_total[1h]) * on (guild_id) group_left (guild_name) group by (guild_id, guild_name) (ooye_bridged_guild_channels))",
          "legendFormat": "{{guild_name}}",
          "queryType": "range",
          "interval": "5m",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "ildkule-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "ildkule-loki"
          },
          "expr": "{job=\"systemd-journal\", host=\"bicep\", syslog_identifier=\"out-of-your-element\"} | json | line_format `{{.level}} {{.message}}`",
          "refId": "A"
        }
      ]
    }
  ]
}
