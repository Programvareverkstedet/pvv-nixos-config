    {
      "id": 6,
      "type": "table",
      "title": "SSH Logins",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "ildkule-loki" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.width", "value": 190 }] },
          {
            "matcher": { "id": "byName", "options": "user" },
            "properties": [
              { "id": "custom.width", "value": 110 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "root": { "color": "red", "index": 0 } } }
                ]
              },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": 0 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "keytype" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RSA": { "color": "#FF7383", "index": 0 },
                      "ED25519": { "color": "green", "index": 1 },
                      "ECDSA": { "color": "yellow", "index": 2 }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null+nan",
                      "result": { "text": "PASSW", "color": "blue", "index": 3 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "host" },
            "properties": [
              { "id": "custom.width", "value": 130 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "sleipner": { "color": "red", "index": 0 } } },
                  {
                    "type": "value",
                    "options": {
                      "isvegg": { "color": "text", "index": 1 },
                      "mirage": { "color": "text", "index": 2 },
                      "microbel": { "color": "text", "index": 3 }
                    }
                  },
                  { "type": "regex", "options": { "pattern": ".*", "result": { "color": "yellow", "index": 4 } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ip" },
            "properties": [
              { "id": "custom.width", "value": 380 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": 0 }] } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^129\\.241\\.(?!210\\.(1[2-9][0-9]|2[0-4][0-9]|25[0-5])$)\\d{1,3}\\.\\d{1,3}$",
                      "result": { "color": "yellow", "index": 0 }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^2001:700:300:(?!1900:).*$",
                      "result": { "color": "yellow", "index": 1 }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(?!129\\.241\\.210\\.(1[2-9][0-9]|2[0-4][0-9]|25[0-5])$)(?!2001:700:300:1900:).*$",
                      "result": { "color": "orange", "index": 2 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\", syslog_identifier=\"sshd-session\"}\n  | result=\"Accepted\"\n  | keep host, ip, key, keytype, user",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 2000,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        {
          "id": "organize",
          "options": {
            "includeByName": { "Time": true, "host": true, "ip": true, "key": true, "keytype": true, "user": true },
            "indexByName": { "Time": 0, "user": 1, "keytype": 4, "host": 2, "ip": 3, "key": 5 }
          }
        }
      ]
    },
