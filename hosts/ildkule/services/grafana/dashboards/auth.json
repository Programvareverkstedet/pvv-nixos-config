    {
      "id": 8,
      "type": "table",
      "title": "Known Keys",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "ildkule-loki" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "keytype" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RSA": { "color": "#FF7383", "index": 0 },
                      "ED25519": { "color": "green", "index": 1 },
                      "ECDSA": { "color": "yellow", "index": 2 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "last host" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "sleipner": { "color": "red", "index": 0 } } },
                  {
                    "type": "value",
                    "options": {
                      "isvegg": { "color": "text", "index": 1 },
                      "mirage": { "color": "text", "index": 2 },
                      "microbel": { "color": "text", "index": 3 }
                    }
                  },
                  { "type": "regex", "options": { "pattern": ".*", "result": { "color": "yellow", "index": 4 } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "user" }]
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\", syslog_identifier=\"sshd-session\"}\n  | result=\"Accepted\"\n  | method=\"publickey\"\n  | keep host, keytype, key, user",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 5000,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        {
          "id": "organize",
          "options": {
            "includeByName": { "Time": true, "user": true, "keytype": true, "key": true, "host": true },
            "indexByName": { "user": 0, "keytype": 1, "key": 2, "host": 3, "Time": 4 }
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "user": { "aggregations": [], "operation": "groupby" },
              "key": { "aggregations": [], "operation": "groupby" },
              "keytype": { "aggregations": ["first"], "operation": "aggregate" },
              "host": { "aggregations": ["first"], "operation": "aggregate" },
              "Time": { "aggregations": ["first"], "operation": "aggregate" }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "keytype (first)": "keytype",
              "host (first)": "last host",
              "Time (first)": "Last used"
            },
            "indexByName": { "user": 0, "keytype (first)": 1, "key": 2, "host (first)": 3, "Time (first)": 4 }
          }
        }
