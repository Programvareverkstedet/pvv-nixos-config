        "text": { "titleSize": 16, "valueSize": 40 }
      },
      "targets": [
        {
          "expr": "count(count by (user, key) (count_over_time({job=\"systemd-journal\", syslog_identifier=\"sshd-session\"} | result=\"Accepted\" | method=\"publickey\" [1d]))) or vector(0)",
          "queryType": "range",
          "interval": "1d",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Keys",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "loki", "uid": "ildkule-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "displayName", "value": "RSA" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF7383" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "displayName", "value": "ED25519" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [
              { "id": "displayName", "value": "ECDSA" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "D" },
            "properties": [
              { "id": "displayName", "value": "PASSW" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "pie",
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"systemd-journal\", syslog_identifier=\"sshd-session\"} | result=\"Accepted\" | method=\"publickey\" | keytype=\"RSA\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=\"systemd-journal\", syslog_identifier=\"sshd-session\"} | result=\"Accepted\" | method=\"publickey\" | keytype=\"ED25519\" [$__range]))",
