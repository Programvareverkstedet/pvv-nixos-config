    {
      "id": 2,
      "type": "stat",
      "title": "Logins/Day",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "loki", "uid": "ildkule-loki" },
      "timeFrom": "24h",
      "fieldConfig": {
        "defaults": {
          "unit": "/day",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value",
        "text": { "titleSize": 16, "valueSize": 40 }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"systemd-journal\", syslog_identifier=\"sshd-session\"} | result=\"Accepted\" [24h])) or vector(0)",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
