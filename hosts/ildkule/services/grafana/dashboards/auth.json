      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\", syslog_identifier=\"sshd-session\"}\n  | result=\"Failed\"\n  | keep host, ip, key, keytype, user",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 2000,
