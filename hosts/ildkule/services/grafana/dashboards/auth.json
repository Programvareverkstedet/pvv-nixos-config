          "expr": "sum(count_over_time({job=\"systemd-journal\", syslog_identifier=\"sshd-session\"} | result=\"Accepted\" | method=\"publickey\" | keytype=\"ECDSA\" [$__range]))",
          "queryType": "instant",
          "refId": "C"
