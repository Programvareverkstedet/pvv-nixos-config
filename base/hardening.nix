{ config, lib, pkgs, ... }:
{
  # https://github.com/NixOS/nixpkgs/blob/nixos-24.05/nixos/modules/profiles/hardened.nix
  # https://github.com/secureblue/secureblue/blob/live/files/system/usr/lib/modprobe.d/secureblue.conf
  boot.blacklistedKernelModules = [
    # Obscure network protocols
    "6lowpan"
    "af_key"
    "ah4"
    "ah6"
    "appletalk"
    "atm"
    "ax25"
    "batman-adv"
    "can"
    "can-dev"
    "esp4"
    "esp6"
    "hsr"
    "ib_core"
    "ieee802154"
    "ieee802154_socket"
    "ip6_vti"
    "ip_vti"
    "ipcomp"
    "ipcomp6"
    "kcm"
    "l2tp_core"
    "l2tp_eth"
    "l2tp_ip"
    "l2tp_ip6"
    "l2tp_netlink"
    "l2tp_ppp"
    "lapb"
    "llc2"
    "netrom"
    "nfc"
    "p8022"
    "phonet"
    "psnap"
    "qrtr"
    "rds"
    "rose"
    "rxrpc"
    "sctp"
    "tipc"
    "x25"
    "xfrm_interface"
    "xfrm_iptfs"
    "xfrm_user"

    # Old or rare or insufficiently audited filesystems
    "adfs"
    "affs"
    "befs"
    "bfs"
    "ceph"
    "cifs"
    "coda"
    "cramfs"
    "dlm"
    "ecryptfs"
    "efs"
    # "erofs" // used by systemd
    "f2fs"
    "freevxfs"
    "gfs2"
    "hfs"
    "hfsplus"
    "hpfs"
    "jffs2"
    "jfs"
    "kafs"
    "ksmbd"
    "minix"
    "nilfs2"
    "ntfs"
    "ntfs3"
    "ocfs2"
    "ocfs2_nodemanager"
    "ocfs2_stackglue"
    "omfs"
    "orangefs"
    "qnx4"
    "qnx6"
    "romfs"
    "sysv"
    "ubifs"
    "udf"
    "ufs"
    "vboxsf"
    "zonefs"

    # Misc
    "aer_inject"
    "af_alg"
    "algif_aead"
    "algif_hash"
    "algif_rng"
    "algif_skcipher"
    "dummy_hcd"
    "firewire-core"
    "firewire_ohci"
    "firewire_sbp2"
    "floppy"
    "gameport"
    "gnss"
    "hwpoison_inject"
    "mce-inject"
    "mtdram"
    "n_hdlc"
    "nandsim"
    "netconsole"
    "nosy"
    "parport"
    "pcspkr"
    "pktgen"
    "scsi_debug"
    "snd_pcsp"
    "vivid"
    "vkms"
  ];

  boot.extraModprobeConfig = lib.concatMapStringsSep "\n"
    (module: "install ${module} ${lib.getExe' pkgs.coreutils "false"}")
    config.boot.blacklistedKernelModules;

  # security.lockKernelModules = true;
  security.protectKernelImage = true;
}
